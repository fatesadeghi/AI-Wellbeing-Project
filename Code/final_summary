import os
import pandas as pd


# ============================================================
# FINAL SUMMARY
# Summary of the final seven-day analysis
# ============================================================


# ============================================================
# 1. PROJECT PATHS
# ============================================================

BASE_DIR = os.path.dirname(
    os.path.dirname(
        os.path.abspath(__file__)
    )
)

RESULTS_DIR = os.path.join(
    BASE_DIR,
    "results"
)

SEVEN_DAY_DIR = os.path.join(
    RESULTS_DIR,
    "seven_day"
)

SEVEN_DAY_FILE = os.path.join(
    SEVEN_DAY_DIR,
    "seven_day_history_wellbeing_relationships.csv"
)

OUTPUT_DIR = os.path.join(
    RESULTS_DIR,
    "final_summary"
)

os.makedirs(
    OUTPUT_DIR,
    exist_ok=True
)


# ============================================================
# 2. CHECK INPUT
# ============================================================

if not os.path.exists(SEVEN_DAY_FILE):

    raise FileNotFoundError(
        "Seven-day analysis result not found:\n"
        f"{SEVEN_DAY_FILE}"
    )


# ============================================================
# 3. LOAD SEVEN-DAY RESULTS
# ============================================================

print("=" * 80)
print("FINAL SUMMARY")
print("=" * 80)

print(
    f"Loading seven-day results:\n"
    f"{SEVEN_DAY_FILE}"
)

df = pd.read_csv(
    SEVEN_DAY_FILE
)


# ============================================================
# 4. BASIC VALIDATION
# ============================================================

required_columns = [
    "Participant",
    "Behavioral_Variable",
    "Wellbeing_Variable",
    "r",
    "p",
    "N",
    "Included",
]

missing_columns = [
    column
    for column in required_columns
    if column not in df.columns
]

if missing_columns:

    raise ValueError(
        "Missing required columns in seven-day results: "
        + ", ".join(missing_columns)
    )


# ============================================================
# 5. GENERAL SUMMARY
# ============================================================

included = df[
    df["Included"] == "Yes"
].copy()

included["r"] = pd.to_numeric(
    included["r"],
    errors="coerce"
)

included["p"] = pd.to_numeric(
    included["p"],
    errors="coerce"
)

valid_r = included[
    included["r"].notna()
]

valid_p = included[
    included["p"].notna()
]

summary = {
    "Analysis": "Seven-day history",
    "History_Definition": (
        "Previous 7 days -> same-day wellbeing"
    ),
    "Participants": (
        df["Participant"].nunique()
    ),
    "Total_Relationships_Tested": (
        len(df)
    ),
    "Relationships_With_N_>=_10": (
        len(included)
    ),
    "Valid_Correlations": (
        len(valid_r)
    ),
    "Mean_r": (
        valid_r["r"].mean()
        if not valid_r.empty
        else None
    ),
    "Mean_absolute_r": (
        valid_r["r"].abs().mean()
        if not valid_r.empty
        else None
    ),
    "Nominally_Significant_p_<_.05": (
        (valid_p["p"] < 0.05).sum()
    ),
    "Behavioral_Variables": (
        df["Behavioral_Variable"].nunique()
    ),
    "Wellbeing_Variables": (
        df["Wellbeing_Variable"].nunique()
    ),
}

summary_df = pd.DataFrame(
    [summary]
)


# ============================================================
# 6. SAVE GENERAL SUMMARY
# ============================================================

summary_file = os.path.join(
    OUTPUT_DIR,
    "final_analysis_summary.csv"
)

summary_df.to_csv(
    summary_file,
    index=False
)


# ============================================================
# 7. NOMINALLY SIGNIFICANT ASSOCIATIONS
# ============================================================

significant = valid_p[
    valid_p["p"] < 0.05
].copy()

significant = significant.sort_values(
    "p"
)


significant_file = os.path.join(
    OUTPUT_DIR,
    "seven_day_nominally_significant.csv"
)

significant.to_csv(
    significant_file,
    index=False
)


# ============================================================
# 8. SUMMARY BY WELLBEING
# ============================================================

if not significant.empty:

    wellbeing_summary = (
        significant
        .groupby(
            "Wellbeing_Variable"
        )
        .size()
        .reset_index(
            name="Nominally_Significant_Associations"
        )
        .sort_values(
            "Nominally_Significant_Associations",
            ascending=False
        )
    )

else:

    wellbeing_summary = pd.DataFrame(
        columns=[
            "Wellbeing_Variable",
            "Nominally_Significant_Associations",
        ]
    )


wellbeing_file = os.path.join(
    OUTPUT_DIR,
    "seven_day_summary_by_wellbeing.csv"
)

wellbeing_summary.to_csv(
    wellbeing_file,
    index=False
)


# ============================================================
# 9. SUMMARY BY BEHAVIOR
# ============================================================

if not significant.empty:

    behavior_summary = (
        significant
        .groupby(
            "Behavioral_Variable"
        )
        .size()
        .reset_index(
            name="Nominally_Significant_Associations"
        )
        .sort_values(
            "Nominally_Significant_Associations",
            ascending=False
        )
    )

else:

    behavior_summary = pd.DataFrame(
        columns=[
            "Behavioral_Variable",
            "Nominally_Significant_Associations",
        ]
    )


behavior_file = os.path.join(
    OUTPUT_DIR,
    "seven_day_summary_by_behavior.csv"
)

behavior_summary.to_csv(
    behavior_file,
    index=False
)


# ============================================================
# 10. TEXT REPORT
# ============================================================

report_file = os.path.join(
    OUTPUT_DIR,
    "final_summary_report.txt"
)

with open(
    report_file,
    "w",
    encoding="utf-8"
) as f:

    f.write(
        "FINAL ANALYSIS SUMMARY\n"
    )

    f.write(
        "======================\n\n"
    )

    f.write(
        "Analysis: Seven-day behavioral history\n"
    )

    f.write(
        "History definition: "
        "Previous 7 days -> same-day wellbeing\n\n"
    )

    f.write(
        f"Participants: "
        f"{summary['Participants']}\n"
    )

    f.write(
        f"Total relationships tested: "
        f"{summary['Total_Relationships_Tested']}\n"
    )

    f.write(
        f"Relationships with N >= 10: "
        f"{summary['Relationships_With_N_>=_10']}\n"
    )

    f.write(
        f"Valid correlations: "
        f"{summary['Valid_Correlations']}\n"
    )

    f.write(
        f"Mean r: "
        f"{summary['Mean_r']}\n"
    )

    f.write(
        f"Mean absolute r: "
        f"{summary['Mean_absolute_r']}\n"
    )

    f.write(
        f"Nominally significant associations "
        f"(p < 0.05): "
        f"{summary['Nominally_Significant_p_<_.05']}\n"
    )

    f.write(
        f"Behavioral variables: "
        f"{summary['Behavioral_Variables']}\n"
    )

    f.write(
        f"Wellbeing variables: "
        f"{summary['Wellbeing_Variables']}\n"
    )

    f.write("\n")

    f.write(
        "Note: p < 0.05 results are treated as "
        "nominally significant exploratory associations. "
        "They do not establish causality.\n"
    )


# ============================================================
# 11. CONSOLE OUTPUT
# ============================================================

print()
print("=" * 80)
print("FINAL SUMMARY COMPLETED")
print("=" * 80)

print(
    f"Participants: "
    f"{summary['Participants']}"
)

print(
    f"Total relationships tested: "
    f"{summary['Total_Relationships_Tested']}"
)

print(
    f"Relationships with N >= 10: "
    f"{summary['Relationships_With_N_>=_10']}"
)

print(
    f"Nominally significant associations: "
    f"{summary['Nominally_Significant_p_<_.05']}"
)

print()
print("Generated files:")

print(
    "  - final_analysis_summary.csv"
)

print(
    "  - final_summary_report.txt"
)

print(
    "  - seven_day_nominally_significant.csv"
)

print(
    "  - seven_day_summary_by_behavior.csv"
)

print(
    "  - seven_day_summary_by_wellbeing.csv"
)

print("=" * 80)
