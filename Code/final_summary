import os
import glob
import pandas as pd


# ============================================================
# FINAL SUMMARY
# Summarize results from analyses 01–05
# No FDR correction
# ============================================================

BASE_DIR = os.path.dirname(
    os.path.dirname(
        os.path.abspath(__file__)
    )
)

RESULTS_DIR = os.path.join(
    BASE_DIR,
    "results"
)

OUTPUT_DIR = os.path.join(
    RESULTS_DIR,
    "final_summary"
)

os.makedirs(OUTPUT_DIR, exist_ok=True)


# ============================================================
# HELPERS
# ============================================================

def find_csv(patterns):
    """Find the first matching CSV file inside results/."""

    for pattern in patterns:
        matches = glob.glob(
            os.path.join(
                RESULTS_DIR,
                "**",
                pattern
            ),
            recursive=True
        )

        # Do not use files from final_summary itself
        matches = [
            path for path in matches
            if os.path.abspath(OUTPUT_DIR)
            not in os.path.abspath(path)
        ]

        if matches:
            return matches[0]

    return None


def relationship_summary(path, analysis_name):
    """
    Summarize analyses that contain relationships.

    Expected relationship columns:
        Participant
        Behavioral_Variable
        Wellbeing_Variable
        r
        p
    """

    if path is None:
        return {
            "Analysis": analysis_name,
            "File_Found": False
        }, None

    df = pd.read_csv(path)

    required = [
        "Participant",
        "Behavioral_Variable",
        "Wellbeing_Variable",
        "r",
        "p"
    ]

    missing = [
        column
        for column in required
        if column not in df.columns
    ]

    if missing:
        return {
            "Analysis": analysis_name,
            "File_Found": True,
            "Error": "Missing columns: " + ", ".join(missing)
        }, None

    df["r"] = pd.to_numeric(
        df["r"],
        errors="coerce"
    )

    df["p"] = pd.to_numeric(
        df["p"],
        errors="coerce"
    )

    if "Included" in df.columns:
        included = df[
            df["Included"]
            .astype(str)
            .str.lower()
            .isin(["yes", "true", "1"])
        ].copy()
    else:
        included = df.copy()

    valid = included.dropna(
        subset=["r", "p"]
    ).copy()

    significant = valid[
        valid["p"] < 0.05
    ].copy()

    summary = {
        "Analysis": analysis_name,
        "File_Found": True,
        "Total_Rows": len(df),
        "Included_Rows": len(included),
        "Valid_Tests": len(valid),
        "Nominal_Significant_p<0.05": len(significant),
        "Participants": valid["Participant"].nunique(),
        "Behavioral_Variables": valid[
            "Behavioral_Variable"
        ].nunique(),
        "Wellbeing_Variables": valid[
            "Wellbeing_Variable"
        ].nunique(),
        "Mean_r": valid["r"].mean(),
        "Mean_Abs_r": valid["r"].abs().mean(),
        "Strong_Associations_Abs_r>=0.50": (
            valid["r"].abs() >= 0.50
        ).sum()
    }

    return summary, valid


def baseline_summary(path):
    """
    Baseline has a different structure from relationship analyses.

    Therefore, do NOT try to calculate r/p statistics
    from the baseline file.
    """

    if path is None:
        return {
            "Analysis": "01_baseline",
            "File_Found": False
        }

    df = pd.read_csv(path)

    return {
        "Analysis": "01_baseline",
        "File_Found": True,
        "Total_Rows": len(df),
        "Total_Columns": len(df.columns),
        "Participants": (
            df["Participant"].nunique()
            if "Participant" in df.columns
            else "N/A"
        ),
        "Nominal_Significant_p<0.05": "N/A"
    }


# ============================================================
# 1. FIND OUTPUT FILES
# ============================================================

files = {
    "01_baseline": find_csv([
        "*baseline*.csv"
    ]),

    "02_same_day": find_csv([
        "*same_day*.csv",
        "*same-day*.csv"
    ]),

    "03_lagged": find_csv([
        "*lagged*.csv",
        "*lag*.csv"
    ]),

    "04_seven_day": find_csv([
        "*seven_day_history_wellbeing_relationships*.csv",
        "*seven_day*.csv"
    ]),

    "05_sensitivity": find_csv([
        "*sensitivity*.csv"
    ])
}


# ============================================================
# 2. BUILD SUMMARY
# ============================================================

summaries = []
valid_results = {}


# -----------------------------
# Baseline
# -----------------------------

baseline_result = baseline_summary(
    files["01_baseline"]
)

summaries.append(
    baseline_result
)


# -----------------------------
# Relationship analyses
# -----------------------------

for analysis_name in [
    "02_same_day",
    "03_lagged",
    "04_seven_day",
    "05_sensitivity"
]:

    summary, valid = relationship_summary(
        files[analysis_name],
        analysis_name
    )

    summaries.append(summary)

    if valid is not None:
        valid_results[analysis_name] = valid


summary_df = pd.DataFrame(summaries)


# ============================================================
# 3. SAVE OVERALL SUMMARY
# ============================================================

summary_path = os.path.join(
    OUTPUT_DIR,
    "final_analysis_summary.csv"
)

summary_df.to_csv(
    summary_path,
    index=False
)


# ============================================================
# 4. SEVEN-DAY SUMMARY BY WELLBEING
# ============================================================

if "04_seven_day" in valid_results:

    df = valid_results["04_seven_day"]

    significant = df[
        df["p"] < 0.05
    ].copy()

    if not significant.empty:

        wellbeing_summary = (
            significant
            .groupby("Wellbeing_Variable")
            .agg(
                Significant_Associations=("p", "size"),
                Participants=("Participant", "nunique"),
                Mean_Abs_r=(
                    "r",
                    lambda x: x.abs().mean()
                ),
                Mean_r=("r", "mean")
            )
            .reset_index()
            .sort_values(
                "Significant_Associations",
                ascending=False
            )
        )

        wellbeing_path = os.path.join(
            OUTPUT_DIR,
            "seven_day_summary_by_wellbeing.csv"
        )

        wellbeing_summary.to_csv(
            wellbeing_path,
            index=False
        )


# ============================================================
# 5. SEVEN-DAY SUMMARY BY BEHAVIOR
# ============================================================

if "04_seven_day" in valid_results:

    df = valid_results["04_seven_day"]

    significant = df[
        df["p"] < 0.05
    ].copy()

    if not significant.empty:

        behavior_summary = (
            significant
            .groupby("Behavioral_Variable")
            .agg(
                Significant_Associations=("p", "size"),
                Participants=("Participant", "nunique"),
                Wellbeing_Measures=(
                    "Wellbeing_Variable",
                    "nunique"
                ),
                Mean_Abs_r=(
                    "r",
                    lambda x: x.abs().mean()
                ),
                Mean_r=("r", "mean")
            )
            .reset_index()
            .sort_values(
                "Significant_Associations",
                ascending=False
            )
        )

        behavior_path = os.path.join(
            OUTPUT_DIR,
            "seven_day_summary_by_behavior.csv"
        )

        behavior_summary.to_csv(
            behavior_path,
            index=False
        )


# ============================================================
# 6. EXPORT NOMINALLY SIGNIFICANT SEVEN-DAY RESULTS
# ============================================================

if "04_seven_day" in valid_results:

    df = valid_results["04_seven_day"]

    significant = (
        df[df["p"] < 0.05]
        .sort_values("p")
        .copy()
    )

    significant_path = os.path.join(
        OUTPUT_DIR,
        "seven_day_nominally_significant.csv"
    )

    significant.to_csv(
        significant_path,
        index=False
    )


# ============================================================
# 7. TEXT REPORT
# ============================================================

report_path = os.path.join(
    OUTPUT_DIR,
    "final_summary_report.txt"
)

with open(
    report_path,
    "w",
    encoding="utf-8"
) as f:

    f.write("=" * 80 + "\n")
    f.write("FINAL ANALYSIS SUMMARY\n")
    f.write("Analyses 01–05\n")
    f.write("FDR correction: NOT USED\n")
    f.write("Significance criterion: raw p < 0.05\n")
    f.write("=" * 80 + "\n\n")

    for _, row in summary_df.iterrows():

        f.write(
            f"Analysis: {row.get('Analysis', '')}\n"
        )

        if row.get("File_Found", False):

            for key in [
                "Total_Rows",
                "Included_Rows",
                "Valid_Tests",
                "Nominal_Significant_p<0.05",
                "Participants",
                "Behavioral_Variables",
                "Wellbeing_Variables",
                "Mean_r",
                "Mean_Abs_r",
                "Strong_Associations_Abs_r>=0.50"
            ]:

                if key in row.index:

                    value = row.get(key)

                    if pd.notna(value):
                        f.write(
                            f"  {key}: {value}\n"
                        )

        else:

            f.write(
                "  Result file not found.\n"
            )

        f.write("\n")


# ============================================================
# 8. CONSOLE OUTPUT
# ============================================================

print("=" * 80)
print("FINAL SUMMARY COMPLETED")
print("=" * 80)

print(
    f"Output directory: {OUTPUT_DIR}"
)

print()
print("Generated files:")

for filename in sorted(
    os.listdir(OUTPUT_DIR)
):

    print(f"  - {filename}")

print()
print("FDR was NOT applied.")
print("Significance criterion: raw p < 0.05")
