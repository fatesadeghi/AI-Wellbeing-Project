import os
import glob
import pandas as pd


# ============================================================
# FINAL SUMMARY
# Summary of analyses 01–05
# ============================================================

BASE_DIR = os.path.dirname(
    os.path.dirname(
        os.path.abspath(__file__)
    )
)

RESULTS_DIR = os.path.join(
    BASE_DIR,
    "results"
)

OUTPUT_DIR = os.path.join(
    RESULTS_DIR,
    "final_summary"
)

os.makedirs(OUTPUT_DIR, exist_ok=True)


# ============================================================
# FIND RESULT FILE
# ============================================================

def find_result(patterns):

    for pattern in patterns:

        matches = glob.glob(
            os.path.join(
                RESULTS_DIR,
                "**",
                pattern
            ),
            recursive=True
        )

        matches = [
            path for path in matches
            if os.path.abspath(OUTPUT_DIR)
            not in os.path.abspath(path)
        ]

        if matches:
            return matches[0]

    return None


# ============================================================
# LOAD RESULTS
# ============================================================

files = {
    "01_build_baseline": find_result([
        "*baseline*.csv"
    ]),

    "02_same_day_analysis": find_result([
        "*same_day*.csv",
        "*same-day*.csv"
    ]),

    "03_lagged_analysis": find_result([
        "*lagged*.csv",
        "*lag*.csv"
    ]),

    "04_seven_day_analysis": find_result([
        "*seven_day_history_wellbeing_relationships*.csv",
        "*seven_day*.csv"
    ]),

    "05_sensitivity_analysis": find_result([
        "*sensitivity*.csv"
    ])
}


# ============================================================
# GENERAL SUMMARY
# ============================================================

summary_rows = []


for analysis, path in files.items():

    row = {
        "Analysis": analysis,
        "File_Found": path is not None
    }

    if path is None:
        summary_rows.append(row)
        continue

    df = pd.read_csv(path)

    row["Rows"] = len(df)
    row["Columns"] = len(df.columns)

    if "Participant" in df.columns:
        row["Participants"] = df["Participant"].nunique()

    if "r" in df.columns:

        r = pd.to_numeric(
            df["r"],
            errors="coerce"
        )

        row["Valid_r"] = r.notna().sum()
        row["Mean_r"] = r.mean()
        row["Mean_abs_r"] = r.abs().mean()

    if "p" in df.columns:

        p = pd.to_numeric(
            df["p"],
            errors="coerce"
        )

        valid_p = p.dropna()

        row["Valid_p"] = len(valid_p)
        row["p_less_0_05"] = (
            valid_p < 0.05
        ).sum()

    if "Behavioral_Variable" in df.columns:
        row["Behavioral_Variables"] = (
            df["Behavioral_Variable"]
            .nunique()
        )

    if "Wellbeing_Variable" in df.columns:
        row["Wellbeing_Variables"] = (
            df["Wellbeing_Variable"]
            .nunique()
        )

    summary_rows.append(row)


summary_df = pd.DataFrame(
    summary_rows
)


# ============================================================
# SAVE GENERAL SUMMARY
# ============================================================

summary_df.to_csv(
    os.path.join(
        OUTPUT_DIR,
        "final_analysis_summary.csv"
    ),
    index=False
)


# ============================================================
# SEVEN-DAY ANALYSIS
# ============================================================

seven_day_file = files[
    "04_seven_day_analysis"
]


if seven_day_file is not None:

    df = pd.read_csv(
        seven_day_file
    )

    if (
        "p" in df.columns
        and "Wellbeing_Variable" in df.columns
    ):

        p = pd.to_numeric(
            df["p"],
            errors="coerce"
        )

        significant = df[
            p < 0.05
        ].copy()

        # ----------------------------------------
        # By wellbeing measure
        # ----------------------------------------

        if not significant.empty:

            wellbeing_summary = (
                significant
                .groupby(
                    "Wellbeing_Variable"
                )
                .size()
                .reset_index(
                    name="Significant_Associations"
                )
                .sort_values(
                    "Significant_Associations",
                    ascending=False
                )
            )

            wellbeing_summary.to_csv(
                os.path.join(
                    OUTPUT_DIR,
                    "seven_day_summary_by_wellbeing.csv"
                ),
                index=False
            )

        # ----------------------------------------
        # By behavioral variable
        # ----------------------------------------

        if "Behavioral_Variable" in significant.columns:

            behavior_summary = (
                significant
                .groupby(
                    "Behavioral_Variable"
                )
                .size()
                .reset_index(
                    name="Significant_Associations"
                )
                .sort_values(
                    "Significant_Associations",
                    ascending=False
                )
            )

            behavior_summary.to_csv(
                os.path.join(
                    OUTPUT_DIR,
                    "seven_day_summary_by_behavior.csv"
                ),
                index=False
            )

        # ----------------------------------------
        # All significant seven-day relationships
        # ----------------------------------------

        significant = significant.sort_values(
            "p"
        )

        significant.to_csv(
            os.path.join(
                OUTPUT_DIR,
                "seven_day_nominally_significant.csv"
            ),
            index=False
        )


# ============================================================
# TEXT SUMMARY
# ============================================================

report_path = os.path.join(
    OUTPUT_DIR,
    "final_summary_report.txt"
)


with open(
    report_path,
    "w",
    encoding="utf-8"
) as f:

    f.write(
        "FINAL ANALYSIS SUMMARY\n"
    )

    f.write(
        "======================\n\n"
    )

    for _, row in summary_df.iterrows():

        f.write(
            f"Analysis: {row['Analysis']}\n"
        )

        for column in summary_df.columns:

            if column == "Analysis":
                continue

            value = row[column]

            if pd.notna(value):
                f.write(
                    f"{column}: {value}\n"
                )

        f.write("\n")


# ============================================================
# CONSOLE OUTPUT
# ============================================================

print("=" * 80)
print("FINAL SUMMARY COMPLETED")
print("=" * 80)

print(
    f"Output directory: {OUTPUT_DIR}"
)

print()
print("Generated files:")

for filename in sorted(
    os.listdir(OUTPUT_DIR)
):

    print(
        f"  - {filename}"
    )
