import os
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt


# ============================================================
# PATHS
# ============================================================

BASE_DIR = os.path.dirname(
    os.path.dirname(
        os.path.abspath(__file__)
    )
)

INPUT_FILE = os.path.join(
    BASE_DIR,
    "results",
    "seven_day",
    "seven_day_history_wellbeing_relationships.csv"
)

OUTPUT_DIR = os.path.join(
    BASE_DIR,
    "results",
    "final"
)

os.makedirs(
    OUTPUT_DIR,
    exist_ok=True
)


# ============================================================
# LOAD RESULTS
# ============================================================

df = pd.read_csv(INPUT_FILE)

required_columns = [
    "Participant",
    "Behavioral_Variable",
    "Wellbeing_Variable",
    "r",
    "p",
    "N",
    "Included"
]

missing_columns = [
    col
    for col in required_columns
    if col not in df.columns
]

if missing_columns:
    raise ValueError(
        f"Missing required columns: {missing_columns}"
    )


# ============================================================
# FILTER INCLUDED RELATIONSHIPS
# ============================================================

included = df[
    df["Included"]
    .astype(str)
    .str.lower()
    .eq("yes")
].copy()

included["r"] = pd.to_numeric(
    included["r"],
    errors="coerce"
)

included["p"] = pd.to_numeric(
    included["p"],
    errors="coerce"
)

included["N"] = pd.to_numeric(
    included["N"],
    errors="coerce"
)


# ============================================================
# BASIC SUMMARY
# ============================================================

total_relationships = len(df)

included_relationships = len(included)

valid_correlations = (
    included["r"].notna().sum()
)

nominally_significant = included[
    included["p"] < 0.05
].copy()

significant_count = len(
    nominally_significant
)

behavior_count = (
    included["Behavioral_Variable"]
    .nunique()
)

wellbeing_count = (
    included["Wellbeing_Variable"]
    .nunique()
)

mean_r = included["r"].mean()

mean_abs_r = included["r"].abs().mean()


# ============================================================
# SUMMARY TABLE BY WELLBEING
# ============================================================

summary_rows = []

for wellbeing, group in included.groupby(
    "Wellbeing_Variable"
):

    significant = group[
        group["p"] < 0.05
    ]

    summary_rows.append({
        "Wellbeing_Variable": wellbeing,
        "Relationships_Tested": len(group),
        "Valid_Correlations": group["r"].notna().sum(),
        "Nominally_Significant": len(significant),
        "Mean_r": group["r"].mean(),
        "Mean_Absolute_r": group["r"].abs().mean()
    })


summary_table = pd.DataFrame(
    summary_rows
)


summary_table.to_csv(
    os.path.join(
        OUTPUT_DIR,
        "final_summary_table.csv"
    ),
    index=False
)


# ============================================================
# NOMINALLY SIGNIFICANT RELATIONSHIPS
# ============================================================

nominally_significant.to_csv(
    os.path.join(
        OUTPUT_DIR,
        "nominally_significant_relationships.csv"
    ),
    index=False
)


# ============================================================
# SEVEN-DAY BEHAVIOR × WELLBEING TABLE
# ============================================================
#
# Previous 7 days of behavioral data
#                ->
# Same-day wellbeing
#
# Each cell represents the number of nominally
# significant participant-level relationships.
# ============================================================

behavior_wellbeing_table = pd.crosstab(
    nominally_significant[
        "Behavioral_Variable"
    ],
    nominally_significant[
        "Wellbeing_Variable"
    ]
)


# ============================================================
# ORDER VARIABLES
# ============================================================

behavior_order = [
    "Steps",
    "Exercise_Count",
    "Exercise_Duration",
    "Exercise_Distance",
    "Exercise_Calories",
    "Exercise_Avg_HR",
    "Sleep_Hours",
    "Sleep_Duration_Score",
    "Deep_Sleep_Minutes",
    "Sleep_Restlessness",
    "Sleep_Composition",
    "Sleep_Revitalization",
    "Sleep_Score"
]


# IMPORTANT:
# These are the exact wellbeing names used
# in the seven-day analysis output.

wellbeing_order = [
    "fatigue",
    "mood",
    "readiness",
    "sleep_quality",
    "stress"
]


behavior_order_existing = [
    x
    for x in behavior_order
    if x in behavior_wellbeing_table.index
]

wellbeing_order_existing = [
    x
    for x in wellbeing_order
    if x in behavior_wellbeing_table.columns
]


behavior_wellbeing_table = (
    behavior_wellbeing_table
    .reindex(
        index=behavior_order_existing,
        columns=wellbeing_order_existing,
        fill_value=0
    )
)


# ============================================================
# ADD TOTAL
# ============================================================

behavior_wellbeing_table["Total"] = (
    behavior_wellbeing_table.sum(axis=1)
)


# ============================================================
# SAVE SEVEN-DAY RELATIONSHIP TABLE
# ============================================================

behavior_wellbeing_table.to_csv(
    os.path.join(
        OUTPUT_DIR,
        "seven_day_behavior_wellbeing_table.csv"
    )
)


# ============================================================
# SEVEN-DAY BEHAVIOR × WELLBEING HEATMAP
# ============================================================

heatmap_data = (
    behavior_wellbeing_table
    .drop(columns=["Total"])
)


plt.figure(
    figsize=(11, 8)
)

plt.imshow(
    heatmap_data.values,
    aspect="auto"
)

plt.xticks(
    range(len(heatmap_data.columns)),
    heatmap_data.columns,
    rotation=45,
    ha="right"
)

plt.yticks(
    range(len(heatmap_data.index)),
    heatmap_data.index
)

plt.xlabel(
    "Wellbeing variable"
)

plt.ylabel(
    "Behavioral variable"
)

plt.title(
    "Seven-Day Behavioral History × Same-Day Wellbeing"
)


# Add values inside cells

for i in range(
    heatmap_data.shape[0]
):

    for j in range(
        heatmap_data.shape[1]
    ):

        value = heatmap_data.iloc[i, j]

        plt.text(
            j,
            i,
            str(int(value)),
            ha="center",
            va="center"
        )


plt.colorbar(
    label=(
        "Number of nominally "
        "significant relationships"
    )
)

plt.tight_layout()

plt.savefig(
    os.path.join(
        OUTPUT_DIR,
        "seven_day_behavior_wellbeing_heatmap.png"
    ),
    dpi=300
)

plt.close()


# ============================================================
# OVERALL SUMMARY CHART
# ============================================================

plt.figure(
    figsize=(8, 5)
)

plt.bar(
    summary_table["Wellbeing_Variable"],
    summary_table["Nominally_Significant"]
)

plt.xlabel(
    "Wellbeing variable"
)

plt.ylabel(
    "Number of nominally significant relationships"
)

plt.title(
    "Nominally Significant Associations by Wellbeing"
)

plt.xticks(
    rotation=30,
    ha="right"
)

plt.tight_layout()

plt.savefig(
    os.path.join(
        OUTPUT_DIR,
        "final_summary_chart.png"
    ),
    dpi=300
)

plt.close()


# ============================================================
# TEXT REPORT
# ============================================================

report_path = os.path.join(
    OUTPUT_DIR,
    "final_summary.txt"
)


with open(
    report_path,
    "w",
    encoding="utf-8"
) as f:

    f.write(
        "FINAL RESULTS SUMMARY\n"
    )

    f.write(
        "=====================\n\n"
    )

    f.write(
        "Analysis framework:\n"
    )

    f.write(
        "Previous 7 days of behavioral data -> "
        "same-day wellbeing\n\n"
    )

    f.write(
        f"Participants: "
        f"{included['Participant'].nunique()}\n"
    )

    f.write(
        f"Total relationships tested: "
        f"{total_relationships}\n"
    )

    f.write(
        f"Relationships included (N >= 10): "
        f"{included_relationships}\n"
    )

    f.write(
        f"Valid correlations: "
        f"{valid_correlations}\n"
    )

    f.write(
        f"Behavioral variables: "
        f"{behavior_count}\n"
    )

    f.write(
        f"Wellbeing variables: "
        f"{wellbeing_count}\n"
    )

    f.write(
        f"Mean r: "
        f"{mean_r:.4f}\n"
    )

    f.write(
        f"Mean absolute r: "
        f"{mean_abs_r:.4f}\n"
    )

    f.write(
        f"Nominally significant associations "
        f"(p < 0.05): "
        f"{significant_count}\n\n"
    )

    f.write(
        "Seven-day behavior × wellbeing table:\n"
    )

    f.write(
        "This table counts nominally significant "
        "participant-level associations between "
        "each behavioral variable measured during "
        "the previous seven days and each same-day "
        "wellbeing variable.\n\n"
    )

    f.write(
        behavior_wellbeing_table.to_string()
    )

    f.write(
        "\n\n"
    )

    f.write(
        "Interpretation note:\n"
    )

    f.write(
        "Associations with p < 0.05 are treated as "
        "nominally significant exploratory associations. "
        "They do not establish causality.\n"
    )


# ============================================================
# FINAL OUTPUT
# ============================================================

print("=" * 80)
print("FINAL RESULTS COMPLETED")
print("=" * 80)

print(
    f"Participants: "
    f"{included['Participant'].nunique()}"
)

print(
    f"Total relationships tested: "
    f"{total_relationships}"
)

print(
    f"Included relationships: "
    f"{included_relationships}"
)

print(
    f"Valid correlations: "
    f"{valid_correlations}"
)

print(
    f"Nominally significant associations: "
    f"{significant_count}"
)

print()
print("Generated:")

print(
    "  results/final/final_summary_table.csv"
)

print(
    "  results/final/nominally_significant_relationships.csv"
)

print(
    "  results/final/seven_day_behavior_wellbeing_table.csv"
)

print(
    "  results/final/seven_day_behavior_wellbeing_heatmap.png"
)

print(
    "  results/final/final_summary.txt"
)

print(
    "  results/final/final_summary_chart.png"
)
